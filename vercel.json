{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generate.mjs": {
      "maxDuration": 300,
      "includeFiles": "public/catalogue.json"
    },
    "api/catalogue.mjs": {
      "includeFiles": "public/catalogue.json"
    },
    "api/history.mjs": {
      "includeFiles": "public/catalogue.json"
    },
    "api/hotspots.mjs": {
      "includeFiles": "public/catalogue.json"
    },
    "api/hotspots-retry.mjs": {
      "includeFiles": "public/catalogue.json"
    }
  },
  "rewrites": [
    { "source": "/api/admin-clients", "destination": "/api/router?route=admin-clients" },
    { "source": "/api/admin-reconciliations", "destination": "/api/router?route=admin-reconciliations" },
    { "source": "/api/billing-checkout", "destination": "/api/router?route=billing-checkout" },
    { "source": "/api/billing-plans", "destination": "/api/router?route=billing-plans" },
    { "source": "/api/billing-portal", "destination": "/api/router?route=billing-portal" },
    { "source": "/api/client-auth", "destination": "/api/router?route=client-auth" },
    { "source": "/api/delete", "destination": "/api/router?route=delete" },
    { "source": "/api/me", "destination": "/api/router?route=me" },
    { "source": "/api/onboarding", "destination": "/api/router?route=onboarding" },
    { "source": "/api/projects", "destination": "/api/router?route=projects" },
    { "source": "/api/status", "destination": "/api/router?route=status" },
    { "source": "/", "destination": "/portal.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' blob: data: https://*.blob.vercel-storage.com https://interieur-ia.aurimmo.fr https://m.media-amazon.com; connect-src 'self' https://*.blob.vercel-storage.com; style-src 'self'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    }
  ]
}
